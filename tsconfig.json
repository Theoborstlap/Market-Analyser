{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["unified_frontend/src/*"],
      "@jse/*": ["unified_frontend/src/markets/jse/*"],
      "@us/*": ["unified_frontend/src/markets/us/*"],
      "@crypto/*": ["unified_frontend/src/markets/crypto/*"]
    }
  },
  "include": ["src", "unified_frontend/src"],
  "exclude": ["**/*.test.ts"]
}
